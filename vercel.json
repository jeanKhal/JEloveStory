{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build",
        "maxLambdaSize": "10mb",
        "installCommand": "npm ci --only=production",
        "buildCommand": "npm run build",
        "includeFiles": [
          "src/**/*",
          "public/**/*",
          "package.json",
          "tsconfig.json"
        ],
        "excludeFiles": [
          "src/assets/_MT_*.jpeg",
          "src/IMAGES/_MT_*.jpeg",
          "src/assets/icon.png",
          "src/IMAGES/icon.png",
          "src/assets/histoire.JPG",
          "src/IMAGES/histoire.JPG",
          "*.xlsx",
          "*.xls"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "CI": "false",
    "GENERATE_SOURCEMAP": "false",
    "DISABLE_ESLINT_PLUGIN": "true",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "SKIP_PREFLIGHT_CHECK": "true"
  }
} 